def shiftkey():
    shift = input("Enter a keyword: ").strip()
    return "".join(shift.lower().split())
def encrypt(text):
    alphabet = "abcdefghijklmnopqrstuvwxyz"
    key = shiftkey()
    keyindex = []
    newword = [i for i in text.lower()]
    positiontext = 0
    positionkey = 0
    while positiontext < len(text):
        if newword[positiontext].isalpha():
            keyindex.append(key[positionkey % len(key)])
            positionkey += 1
            positiontext += 1
        else:
            keyindex.append(newword[positiontext])
            positiontext += 1
    positiontext = 0
    for x in newword[:]:
        if x in alphabet:
            newword[positiontext] = alphabet[(alphabet.index(x) + alphabet.index(keyindex[positiontext]))%26]
        else:
            newword[positiontext] = newword[positiontext]
        positiontext += 1
    return "".join(newword)
print(encrypt("Hello World"))
